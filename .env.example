APP_NAME=HvaMenerPartiet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nb
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nb_NO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hvamenerpartiet
DB_USERNAME=hvamenerpartiet
DB_PASSWORD=hemmelig

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Må være lengre enn den lengste jobben (klassifisering kan ta flere minutter)
REDIS_QUEUE_RETRY_AFTER=1000

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ollama kjører helst på egen server med GPU
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELL=gemma3:27b
OLLAMA_EMBEDDINGMODELL=bge-m3
OLLAMA_TIDSAVBRUDD=600
# Hvor mange klassifiseringsjobber Horizon kjører samtidig mot Ollama
OLLAMA_SAMTIDIGE=2

