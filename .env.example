APP_NAME=HvaMenerPartiet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nb
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nb_NO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hvamenerpartiet
DB_USERNAME=hvamenerpartiet
DB_PASSWORD=hemmelig

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Må være lengre enn den lengste jobben (klassifisering kan ta flere minutter)
REDIS_QUEUE_RETRY_AFTER=1000

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Søkemotorer og LLM-er får bare indeksere i produksjon. Overstyr med SEO_INDEKSER=true/false.
# SEO_INDEKSER=

# Offentlige sider caches ferdig rendret i 24 timer (av når APP_ENV=local).
# Cachen tømmes når innhold endres, med «php artisan optimize» og når APP_DEPLOYMENT endres.
# SIDECACHE=true
# SIDECACHE_LEVETID=86400
# APP_DEPLOYMENT=

# Matomo-analyse på den offentlige siden (ikke admin). La stå tomt for å slå av.
MATOMO_HOST=analytics.laaknor.no
MATOMO_SITE_ID=8

# Ollama kjører helst på egen server med GPU
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELL=gemma3:27b
OLLAMA_EMBEDDINGMODELL=bge-m3
# Egen server for embeddings, hvis den ikke er den samme som OLLAMA_URL.
# Med llama.cpp-server: start den med --embeddings og sett API til openai.
OLLAMA_EMBEDDING_URL=
OLLAMA_EMBEDDING_API=ollama
OLLAMA_TIDSAVBRUDD=600
# Tenkemodus for modeller som qwen3. Av gir mer pålitelige JSON-svar.
OLLAMA_TENK=false
# Hvor mange klassifiseringsjobber Horizon kjører samtidig mot Ollama
OLLAMA_SAMTIDIGE=2

# Prosessflyten: start neste steg av seg selv når det er ledig kapasitet
FLYT_AUTOMATISK=true
# Samtidige jobber for innlesing og digitalisering (samme tall brukes av Horizon)
FLYT_KAPASITET_IMPORT=2

# «Send til feilsøking» i admin. Lag tokenet med: openssl rand -hex 32
# Tomt token slår av /api/feilsoking. GitHub-tokenet (fine-grained, bare
# «Issues: Read and write» på repoet) gir en issue per sak. Repoet er
# offentlig, så issuen får bare de offentlige delene av pakken.
FEILSOKING_TOKEN=
FEILSOKING_GITHUB_TOKEN=
FEILSOKING_GITHUB_REPO=Laaknor/HvaMenerPartiet
