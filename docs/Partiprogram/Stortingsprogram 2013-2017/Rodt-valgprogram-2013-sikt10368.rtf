\par 
\par \hich\af31506\dbch\af31505\loch\f31506 \hich\f31506 Ny informasjonsteknologi forandrer dagligliv og samfunn i h\'f8\loch\f31506 \hich\f31506 yt tempo. R\'f8\loch\f31506 \hich\f31506 dt \'f8\loch\f31506 n\hich\af31506\dbch\af31505\loch\f31506 \hich\f31506 
