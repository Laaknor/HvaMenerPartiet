\par 
\par \pard\tx0\tx4794\plain\lang1044\f2\fs36 PRlNSIPPROGRAM* \plain\lang1044\f2\fs24 \{\{\plain\lang1044\f2\fs20 * Et samepolitisk arbeidsprogram for AKP(m-l) skal behandles sammen med resten av partiets arbeidsprogram i 1981.\plain\lang1044\f2\fs24 \}\}
